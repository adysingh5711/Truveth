{
    "compilerOptions": {
        "target": "es2020",
        "lib": [
            "es2020"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "noEmit": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "types": [
            "mocha",
            "node"
        ]
    },
    "include": [
        "hardhat.config.js",
        "hardhat-env.d.ts",
        "test/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "src"
    ]
}